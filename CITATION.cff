    given-names: Israel D.
    orcid: https://orcid.org/0009-0009-6801-4103
repository-code: https://github.com/israelflores8789/eig3x3-lean
keywords:
  - Lean 4
  - eigenvalues
  - eigenvectors
  - eigendecomposition
  - numerically stable
license: Apache-2.0
